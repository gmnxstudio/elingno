# Turso LibSQL Database Credentials
# For local development without remote Turso, can be left blank or set to: file:local.db
TURSO_DATABASE_URL="file:local.db"
TURSO_AUTH_TOKEN=""

# Groq API Key (whisper-large-v3-turbo for Indonesian industrial speech-to-text)
GROQ_API_KEY=""

# Google Gemini API Key (gemini-2.5-flash for structured log synthesis)
GEMINI_API_KEY=""

# Web Push VAPID Keys
# Generate via: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:operations@elingno.local"

# Cron Secret for /api/cron/reminders
CRON_SECRET="elingno-cron-secret-key-321"
